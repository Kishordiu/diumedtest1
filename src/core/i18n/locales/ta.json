    "step2": { "title": "என்ன மதிப்பிட முடியும்", "can": "இதய துடிப்பு மதிப்பீடு (ஒளியியல், சோதனை நிலை)", "cannot": "DiuMed நோயை கண்டறிய, இரத்த ஆக்ஸிஜனை துல்லியமாக அளவிட அல்லது மருத்துவ பரிசோதனையை மாற்ற முடியாது.", "body": "கேமரா அடிப்படையிலான அளவீடுகள் ஒளியியல் மதிப்பீடுகள். துல்லியம் ஒளி, அசையாமை மற்றும் தோல் நிறத்தைப் பொறுத்தது.", "warning": "அவசர அறிகுறிகள் இருந்தால் உடனடியாக அவசர சேவைகளை அழைக்கவும்." },
    "step3": { "title": "தனியுரிமை & சம்மதம்", "body": "உங்கள் சுகாதார தரவு உங்கள் கணக்கில் மட்டுமே சேமிக்கப்படும். விற்கப்படுவதில்லை, உங்கள் அனுமதியின்றி பகிரப்படுவதில்லை. கேமரா செயலாக்கம் முழுவதும் உங்கள் சாதனத்தில் நடக்கிறது.", "consent": "DiuMed ஒளியியல் மதிப்பீடுகளை வழங்குகிறது, மருத்துவ நோயறிதல்களை அல்ல என்று புரிந்துகொள்கிறேன்.", "agree": "புரிந்தது — தொடரவும்", "decline": "இப்போது வேண்டாம்" },
